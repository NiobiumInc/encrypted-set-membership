# frozen, collision-free snapshots (65,536 / 131,072 / 1,048,576 names) so the
# larger sizes are deterministic without a fetch.
# The rest stay ignored (fetched/regenerated on demand).
datasets/notable_people.txt
datasets/combined.txt

